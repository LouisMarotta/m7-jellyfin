---
import Layout from "../../../layouts/Layout.astro";
import InstallLayout from "../../../components/InstallLayout.astro";

import { getT } from "../../../i18n/translations";

export const getStaticPaths = () => {
	return ["en", "it"].map((code) => ({
		params: { locale: code },
	}));
};

const t = getT(Astro.currentLocale ?? "en");

const steps = [
	t("install.linux.step1"),
	t("install.linux.step2"),
	t("install.linux.step3"),
	t("install.linux.step4"),
];
---

<Layout title={t("install.linux.name")}>
	<InstallLayout
		platform="linux"
		platformName={t("install.linux.name")}
		requirements={t("install.requirements.linux")}
		steps={steps}
		githubUrl="https://github.com/LouisMarotta/m7-jellyfin#readme"
		releasesUrl="https://github.com/LouisMarotta/m7-jellyfin/releases/latest"
	/>
</Layout>
