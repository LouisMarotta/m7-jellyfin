---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Feature from "../../components/Feature.astro";
import BottomHero from "../../components/BottomHero.astro";

import { Gamepad2, Play, Feather, FolderGit2, Zap, Shield, ArrowRight, Monitor, Gamepad, Laptop } from '@lucide/astro';

// Handle translations
import { Locale } from "@mannisto/astro-i18n/runtime";

export const getStaticPaths = () => {
	return Locale.supported.map((code) => ({
		params: { locale: code },
	}));
};

const t = Locale.t(Astro.url);
const locale = Locale.from(Astro.url);

const ps3Path = Locale.url(locale, "/install/ps3");
const linuxPath = Locale.url(locale, "/install/linux");
const windowsPath = Locale.url(locale, "/install/windows");
---

<Layout showNav={false}>
	<Hero />

	<BottomHero>
		<div class="features-grid">
			<Feature>
				<span slot="icon"><Feather size={32} /></span>
				<h3 slot="title">{t("home.features.lightweight.title")}</h3>
				<span slot="description">{t("home.features.lightweight.desc")}</span>
			</Feature>
			<Feature>
				<span slot="icon"><Play size={32} /></span>
				<h3 slot="title">{t("home.features.play.title")}</h3>
				<span slot="description">{t("home.features.play.desc")}</span>
			</Feature>
			<Feature>
				<span slot="icon"><Zap size={32} /></span>
				<h3 slot="title">{t("home.features.fast.title")}</h3>
				<span slot="description">{t("home.features.fast.desc")}</span>
			</Feature>
			<Feature>
				<span slot="icon"><Shield size={32} /></span>
				<h3 slot="title">{t("home.features.private.title")}</h3>
				<span slot="description">{t("home.features.private.desc")}</span>
			</Feature>
			<Feature>
				<span slot="icon"><Gamepad2 size={32} /></span>
				<h3 slot="title">{t("home.features.devices.title")}</h3>
				<span slot="description">{t("home.features.devices.desc")}</span>
			</Feature>
			<Feature>
				<span slot="icon"><FolderGit2 size={32} /></span>
				<h3 slot="title">{t("home.features.opensource.title")}</h3>
				<span slot="description">{t("home.features.opensource.desc")}</span>
			</Feature>
		</div>
	</BottomHero>

	<section class="getstarted">
		<h2 class="getstarted-title">{t("home.getstarted.title")}</h2>
		<p class="getstarted-subtitle">{t("home.getstarted.subtitle")}</p>

		<div class="platform-container">
			<a class="platform-card" href={ps3Path}>
				<div class="platform-icon"><Gamepad size={28} /></div>
				<span class="platform-name">{t("home.getstarted.ps3")}</span>
				<span class="platform-desc">{t("home.getstarted.ps3.desc")}</span>
				<span class="platform-cta">{t("home.getstarted.cta")} <ArrowRight size={16} /></span>
			</a>

			<a class="platform-card" href={linuxPath}>
				<div class="platform-icon"><Monitor size={28} /></div>
				<span class="platform-name">{t("home.getstarted.linux")}</span>
				<span class="platform-desc">{t("home.getstarted.linux.desc")}</span>
				<span class="platform-cta">{t("home.getstarted.cta")} <ArrowRight size={16} /></span>
			</a>

			<a class="platform-card" href={windowsPath}>
				<div class="platform-icon"><Laptop size={28} /></div>
				<span class="platform-name">{t("home.getstarted.windows")}</span>
				<span class="platform-desc">{t("home.getstarted.windows.desc")}</span>
				<span class="platform-cta">{t("home.getstarted.cta")} <ArrowRight size={16} /></span>
			</a>
		</div>
	</section>
</Layout>


<style>
	.features-grid {
		max-width: 1024px;
		margin: auto;
		padding-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 20px;
	}

	.getstarted {
		max-width: 1024px;
		margin: 0 auto;
		padding: 64px 24px;
		text-align: center;
	}

	.getstarted-title {
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--color-primary-dark);
	}

	.getstarted-subtitle {
		color: var(--color-muted);
		margin: 8px 0 40px;
		font-size: 1.05rem;
	}

	.platform-container {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
	}

	.platform-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 8px;
		padding: 28px;
		background: var(--color-surface);
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--color-text);
		text-align: left;
		transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
	}

	.platform-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow);
		border-color: var(--color-primary);
	}

	.platform-icon {
		width: 52px;
		height: 52px;
		border-radius: 12px;
		background: var(--color-primary);
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 8px;
	}

	.platform-name {
		font-size: 1.2rem;
		font-weight: 700;
	}

	.platform-desc {
		color: var(--color-muted);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.platform-cta {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 8px;
		color: var(--color-primary);
		font-weight: 600;
	}
</style>
